# 可选：volcengine / ark / deepseek / openai
AI_PROVIDER=volcengine

# 火山方舟 / 豆包视觉模型
ARK_API_KEY=你的火山方舟apikey
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 填火山方舟控制台里的视觉模型 ID 或 Endpoint ID
ARK_MODEL=你的视觉模型ID或EndpointID
# 文案生成使用更快的文本模型；不填写时默认使用 doubao-seed-2-0-lite-260215
ARK_TEXT_MODEL=doubao-seed-2-0-lite-260215
# 默认关闭深度思考，让网页请求能在常见的 60 秒函数时限内返回
ARK_THINKING=off

# DeepSeek 文本分析
DEEPSEEK_API_KEY=sk-你的deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 如果要切回 OpenAI 图片识别，把 AI_PROVIDER 改成 openai 并配置这里
OPENAI_API_KEY=sk-你的openai-key
OPENAI_MODEL=gpt-4.1-mini
